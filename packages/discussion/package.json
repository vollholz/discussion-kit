{
  "name": "@vollholz/discussion",
  "version": "1.2.0",
  "description": "Kommentare, Anhänge und Benachrichtigungen an beliebigen Zielen einer App: Migrationen, Fastify-Plugin, Ablage, Verschlüsselung",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/vollholz/discussion-kit.git", "directory": "packages/discussion" },
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./release-notes": { "types": "./dist/release-notes.d.ts", "default": "./dist/release-notes.js" },
    "./package.json": "./package.json"
  },
  "bin": { "discussion-notes": "./dist/notes-cli.js" },
  "files": ["dist", "migrations", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "@fastify/type-provider-typebox": "^6.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "6.1.0",
    "fastify": "5.12.6",
    "pg": "8.23.1",
    "@types/pg": "8.23.1"
  }
}
