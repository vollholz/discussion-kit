{
  "name": "@vollholz/discussion-web",
  "version": "1.0.1",
  "description": "Oberfläche zu @vollholz/discussion (React): Kommentare mit Erwähnungen, Anhänge, Glocke für Benachrichtigungen",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/vollholz/discussion-kit.git", "directory": "packages/discussion-web" },
  "engines": { "node": ">=24" },
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./iam": { "types": "./dist/iam.d.ts", "default": "./dist/iam.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@vollholz/iam-web": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@vollholz/iam-web": { "optional": true }
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vollholz/iam-web": "2.0.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
